{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfwb",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat", "pipe_to_backward_propagation"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["UUID", "VL_PATH", "TR_PASSWORD", "TR_PATH"]
  },
  "observability": {
    "enabled": false
  },
  "minify": true
}
