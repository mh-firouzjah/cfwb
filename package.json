{
  "name": "cfwb",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "^22.18.0 || >=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "prettier --write README.md src test vitest.config.ts wrangler.jsonc tsconfig.json package.json",
    "format:check": "prettier --check README.md src test vitest.config.ts wrangler.jsonc tsconfig.json package.json",
    "lint": "oxlint --type-aware --vitest-plugin --deny-warnings --report-unused-disable-directives src test && oxlint --vitest-plugin --deny-warnings --report-unused-disable-directives vitest.config.ts",
    "test": "vitest run --silent --reporter=dot",
    "test:verbose": "vitest run --silent=false --reporter=verbose",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "26.6.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "ws": "8.21.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20261019.1": true
  }
}
